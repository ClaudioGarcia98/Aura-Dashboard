{
  "name": "aura",
  "private": true,
  "version": "1.2.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/check-build.js",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "vitest run",
    "test:browser": "playwright test",
    "build:extension:chromium": "vite build --mode extension-chromium && node scripts/check-extension.js chromium",
    "build:extension:firefox": "vite build --mode extension-firefox && node scripts/check-extension.js firefox",
    "build:extensions": "npm run build:extension:chromium && npm run build:extension:firefox",
    "lint:extension": "node scripts/lint-extension.js",
    "test:extension": "playwright test --config playwright.extension.config.js",
    "package:extensions": "npm run build:extensions && npm run lint:extension && node scripts/package-extensions.js"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "addons-linter": "^10.14.0",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "fflate": "^0.8.3",
    "globals": "^17.13.0",
    "jsdom": "^29.1.1",
    "sharp": "^0.35.5",
    "vite": "^8.3.4",
    "vitest": "^4.1.12"
  }
}
